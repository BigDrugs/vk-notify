[Unit]
Description=VK to Telegram notification bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/vk-notify
EnvironmentFile=/opt/vk-notify/.env
ExecStart=/opt/vk-notify/.venv/bin/python /opt/vk-notify/vk_notify.py
Restart=always
RestartSec=10

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
