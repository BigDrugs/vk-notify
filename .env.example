# Токен пользователя VK со скоупом messages (получить через vkhost.github.io -> Kate Mobile)
VK_TOKEN=vk1.a....

# Токен бота из @BotFather
TG_BOT_TOKEN=123456:ABC-DEF...

# Ваш chat_id с ботом (узнать через @userinfobot или getUpdates)
TG_CHAT_ID=123456789

# true = уведомлять только о личных сообщениях, без групповых чатов
ONLY_PRIVATE=false

# false = не пересылать текст сообщения, только "новое сообщение от X"
FORWARD_TEXT=true

# Чаты/люди, которых не уведомлять: peer_id через запятую (для бесед это 2000000000+id)
IGNORE_PEER_IDS=

# Заглушенные в VK чаты: skip = не пересылать вообще (по умолчанию), silent = слать в TG без звука
MUTED_MODE=skip
